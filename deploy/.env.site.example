# Per-site settings for deploy/docker-compose.yml. Copy to deploy/.env (next to
# the compose file) and fill in — ONE copy per site.
#
#   cd deploy && cp .env.site.example .env   # then edit .env
#   docker compose up -d --build

# Which client config to build into the image: clients/<CLIENT>/config.js
CLIENT=demo

# Admin login. Generate these from the repo root:
#   npm run gen-secret      -> paste into JWT_SECRET
#   npm run hash-password   -> paste the hash into ADMIN_PASSWORD_HASH
JWT_SECRET=
ADMIN_PASSWORD_HASH=

# Password for THIS site's Postgres (any strong string; both services use it).
DB_PASSWORD=change-me-to-something-strong

# Host port to expose the app on. Give each site a UNIQUE port if you run
# several via raw compose on one box. (Coolify assigns ports for you instead.)
APP_PORT=3001

# Single-domain deploy (frontend + API same origin) → leave both empty.
# Only set these for a split frontend/API origin.
PUBLIC_BASE_URL=
CORS_ORIGIN=
