# ============================================================================
# Storefront backend environment. Copy to `.env` (gitignored) and fill in.
# THIS FILE IS THE DEPLOYMENT MANUAL. Every var is optional except where noted:
# with an empty .env the server still boots in degraded mode — /api/health says
# { db: false }, every data route returns 503, and the storefront falls back to
# config products with WhatsApp-only checkout. That IS the supported deployment
# mode until a database is connected.
# ============================================================================

# --- Core ---

# Port the API server listens on. The Vite dev proxy targets 3001.
PORT=3001

# Required for admin login. Any long random string; generate one with:
#   npm run gen-secret
JWT_SECRET=

# Required for admin login. Bcrypt hash of the admin password; generate with:
#   npm run hash-password
# (paste the printed hash here — the plaintext password is never stored)
ADMIN_PASSWORD_HASH=

# --- Database (any Postgres: Neon / Supabase / RDS / self-hosted) ---

# Standard Postgres connection string:
#   postgres://user:pass@host:5432/dbname
# Managed hosts (Neon/Supabase/…) give you this string in their dashboard —
# it usually ends with ?sslmode=require. Local examples:
#   Docker:  postgres://storefront:storefront@localhost:5432/storefront
#   Native:  postgres://postgres:yourpassword@localhost:5432/storefront
# Leave empty to run the server in degraded (no-database) mode.
# After setting it, run: npm run db:migrate && npm run db:seed
DATABASE_URL=

# TLS for the database connection:
#   auto    (default) — TLS on unless the host is localhost/127.0.0.1
#   require           — always TLS (managed hosts usually need this)
#   off               — never TLS (local Docker/self-hosted without TLS)
DATABASE_SSL=auto

# --- Images ---

# Image storage provider for the admin's upload button:
#   none       — uploads disabled (503); pasted image URLs still work
#   local      — files saved to backend/uploads/ (gitignored), served at
#                /api/uploads/*. Simple and free — the chosen setup for the
#                VPS/Coolify deploy, where a persistent volume is mounted at
#                backend/uploads (see deploy/docker-compose.yml + DEPLOY_VPS.md)
#                so images survive redeploys. CAUTION only on ephemeral-disk
#                PaaS (Render/Railway/Fly WITHOUT a volume): there images vanish.
#   cloudinary | s3 — env slots reserved; adapters not implemented yet
STORAGE_PROVIDER=local

# Only needed when the frontend is served from a DIFFERENT origin than the API
# (e.g. CDN frontend + separate API host): absolute prefix for uploaded image
# URLs, e.g. https://api.example.com — empty keeps them relative (/api/uploads).
PUBLIC_BASE_URL=

# cloudinary://api_key:api_secret@cloud_name  (only when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_URL=

# Only when STORAGE_PROVIDER=s3:
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Deploy (future) ---

# In production set this to the frontend's origin, e.g. https://shop.example.com
# Empty = allow same-origin / dev proxy usage only. With the single-container
# VPS deploy (backend serves the frontend) it's same-origin, so leave it EMPTY.
CORS_ORIGIN=

# ============================================================================
# VPS / Docker / Coolify deployment (see docs/guides/DEPLOY_VPS.md)
# ============================================================================
# In the single-container deploy, the SAME server serves the API and the built
# storefront, so the frontend calls /api on its own origin — no CORS, and no
# VITE_API_URL needed. The build picks the client via a build arg (CLIENT), and
# these two DB settings matter when Postgres runs alongside the app on the box:
#
#   DATABASE_URL   -> point at the in-box Postgres, e.g.
#                     postgres://storefront:PASSWORD@db:5432/storefront
#                     (host is the container/service name, NOT localhost)
#   DATABASE_SSL=off  <- REQUIRED for the in-box Postgres: it has no TLS, and
#                        "auto" would try TLS for a non-localhost host and fail.
#
# Everything else above is set per site in the Coolify dashboard (or in
# deploy/.env for raw docker-compose). Generate JWT_SECRET / ADMIN_PASSWORD_HASH
# with `npm run gen-secret` and `npm run hash-password`.
